diff --git a/lib/Vt102Emulation.cpp b/lib/Vt102Emulation.cpp
index be82181..bf30344 100644
--- a/lib/Vt102Emulation.cpp
+++ b/lib/Vt102Emulation.cpp
@@ -405,6 +405,14 @@ void Vt102Emulation::processWindowAttributeChange()
   // ignored, only the second char in ST ("\e\\") is appended to tokenBuffer.
   QString newValue = QString::fromWCharArray(tokenBuffer + i + 1, tokenBufferPos-i-2);
 
+  // OSC 6 (tab colour) is sent as several sequences in a row, one per colour
+  // channel, so pass each one on instead of keeping only the last.
+  if (attributeToChange == 6)
+  {
+    emit titleChanged(attributeToChange, newValue);
+    return;
+  }
+
   _pendingTitleUpdates[attributeToChange] = newValue;
   _titleUpdateTimer->start(20);
 }
