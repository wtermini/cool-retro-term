+static void drawBlockChar(QPainter& paint, int x, int y, int w, int h, uint code)
+{
+    // Block elements (U+2580..U+259F). Drawn as filled rectangles covering
+    // the whole cell so adjacent cells join seamlessly, independent of the
+    // font's glyph coverage and of the configured line spacing.
+    const QColor color = paint.pen().color();
+    const int cx = w / 2;
+    const int cy = h / 2;
+
+    auto fill = [&](int rx, int ry, int rw, int rh) {
+        if (rw > 0 && rh > 0)
+            paint.fillRect(x + rx, y + ry, rw, rh, color);
+    };
+
+    // Lower N/8 blocks (U+2581..U+2588)
+    if (code >= 0x2581 && code <= 0x2588) {
+        const int bh = qRound(h * (code - 0x2580) / 8.0);
+        fill(0, h - bh, w, bh);
+        return;
+    }
+    // Left N/8 blocks (U+2589..U+258F), from 7/8 down to 1/8
+    if (code >= 0x2589 && code <= 0x258F) {
+        const int bw = qRound(w * (0x2590 - code) / 8.0);
+        fill(0, 0, bw, h);
+        return;
+    }
+    // Shades
+    if (code >= 0x2591 && code <= 0x2593) {
+        QColor c = color;
+        c.setAlphaF(color.alphaF() * (code - 0x2590) / 4.0);
+        paint.fillRect(x, y, w, h, c);
+        return;
+    }
+
+    // Quadrants: bits = UL, UR, LL, LR
+    enum { UL = 1, UR = 2, LL = 4, LR = 8 };
+    int q = 0;
+    switch (code) {
+    case 0x2580: q = UL | UR; break;           // upper half
+    case 0x2590: q = UR | LR; break;           // right half
+    case 0x2594: fill(0, 0, w, qMax(1, qRound(h / 8.0))); return;     // upper 1/8
+    case 0x2595: { int bw = qMax(1, qRound(w / 8.0)); fill(w - bw, 0, bw, h); return; } // right 1/8
+    case 0x2596: q = LL; break;
+    case 0x2597: q = LR; break;
+    case 0x2598: q = UL; break;
+    case 0x2599: q = UL | LL | LR; break;
+    case 0x259A: q = UL | LR; break;
+    case 0x259B: q = UL | UR | LL; break;
+    case 0x259C: q = UL | UR | LR; break;
+    case 0x259D: q = UR; break;
+    case 0x259E: q = UR | LL; break;
+    case 0x259F: q = UR | LL | LR; break;
+    default: return;
+    }
+    if (q & UL) fill(0, 0, cx, cy);
+    if (q & UR) fill(cx, 0, w - cx, cy);
+    if (q & LL) fill(0, cy, cx, h - cy);
+    if (q & LR) fill(cx, cy, w - cx, h - cy);
+}
+
+static void drawSymbolChar(QPainter& paint, int x, int y, int w, int h, uint code)
+{
+    const QColor color = paint.pen().color();
+    switch (code) {
+    case 0x23FA: { // BLACK CIRCLE FOR RECORD: filled dot, centred in the cell
+        const qreal d = qMin(w, h) * 0.6;
+        paint.save();
+        paint.setRenderHint(QPainter::Antialiasing, true);
+        paint.setPen(Qt::NoPen);
+        paint.setBrush(color);
+        paint.drawEllipse(QRectF(x + (w - d) / 2.0, y + (h - d) / 2.0, d, d));
+        paint.restore();
+        break;
+    }
+    case 0x23BF: { // BOTTOM LEFT CORNER: vertical stroke down the middle, then right
+        const int cx = x + w / 2;
+        const int cy = y + h / 2;
+        const int ex = x + w - 1;
+        paint.drawLine(cx, y, cx, cy);
+        paint.drawLine(cx, cy, ex, cy);
+        break;
+    }
+    }
+}
